# Copy to .env and fill in. .env is git-ignored; this file is not.

# Claude, for answer generation in api/
ANTHROPIC_API_KEY=

# Embeddings, for ingest/ (OpenAI by default; Anthropic has no embeddings API)
# Uncomment once you have a key. A blank value counts as set and blocks the OPENAI_API_KEY fallback.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# Search index in Postgres + pgvector, for ingest/. Optional: without it the
# index is database/index.json. `neon link` writes DATABASE_URL to .env.local
# instead, which ingest/ also reads.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Figure images in Cloudflare R2, for `npm run upload:figures` in web/. Create an
# R2 API token with Object Read & Write on this bucket only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=openvalence-assets
# R2_PUBLIC_URL=https://pub-5d0dc56e7ee1441885d1668bc111a5cc.r2.dev
